# .env.example
SEARCH_URL=https://example.com/search
RESULT_URL=https://example.com/result
USER_AGENT=Mozilla/5.0 Puppy/Master
INPUT_SELECTOR=input[name="name"]
HIDDEN_SELECTOR=input[type="hidden"]
PAGINATION_SELECTOR=.pagination-ys
ROLL_REGEX=showresult\('([A-Z0-9]+)'\)
DB_PATH=puppy.db
SQL_FILE=schema.sql
REQUEST_TIMEOUT=30
MIN_DELAY=0.2
MAX_DELAY=0.5
MAX_RETRIES=5

# Optional remote DB
DB_TYPE=sqlite
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=puppy_db